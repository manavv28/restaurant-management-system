# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 APP_ENV=production AUTO_CREATE_SCHEMA=false SEED_SAMPLE_DATA=false ENABLE_PAYMENT_SIMULATION=false
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN --mount=type=secret,id=system_ca     if [ -f /run/secrets/system_ca ]; then export PIP_CERT=/run/secrets/system_ca; fi;     pip install --no-cache-dir -r requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
COPY backend/app ./app
ARG DATABASE_CA_SOURCE=official
RUN --mount=type=secret,id=system_ca --mount=type=secret,id=supabase_ca if [ -f /run/secrets/system_ca ]; then export SSL_CERT_FILE=/run/secrets/system_ca; fi; if [ "$DATABASE_CA_SOURCE" = official ]; then python -m app.build_database_ca; elif [ "$DATABASE_CA_SOURCE" = operator ]; then python -m app.build_database_ca --certificate-file /run/secrets/supabase_ca; else exit 1; fi
COPY supabase/migrations ./migrations
RUN useradd --uid 10001 --create-home biteai && chown -R biteai:biteai /app
USER biteai
EXPOSE 8080
ENTRYPOINT ["python", "-m", "app.cloud_run"]
CMD ["serve"]
