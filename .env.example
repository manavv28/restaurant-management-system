# Copy to .env at repository root for scripts/dev.sh.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
APP_ENV=development
DATABASE_URL=sqlite:///./biteai.sqlite
SEED_SAMPLE_DATA=true
ENABLE_PAYMENT_SIMULATION=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional provider integrations. Server-side only; never prefix secrets NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_PLACES_API_KEY=
# Frontend -> backend internal URL; set in Vercel separately.
API_INTERNAL_URL=http://127.0.0.1:8000
# Exact, operator-approved restaurant menu hostnames (no wildcards).
APPROVED_MENU_HOSTS=
# Optional authorised payment integration. Never provide UPI PINs or GPay credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only restaurant IDs with completed merchant onboarding may create orders.
RAZORPAY_RESTAURANT_IDS=
# Production supervisor only. Local dev: python -m app.catalog_worker --seed-osm --loop.
CATALOG_WORKER_ENABLED=false

# Production requires reviewed migrations. Local SQLite may create tables automatically.
AUTO_CREATE_SCHEMA=true
# Optional automatic Google discovery when no priced database match exists (provider quotas apply).
DISCOVERY_ON_MISS=false
# Optional Google Maps browser key. Restrict to your site referrers and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
# TLS SMTP for email verification and password reset; never place credentials in browser variables.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_APP_URL=
# Payment and offer reservation email verification is required by default in production.
REQUIRE_VERIFIED_EMAIL=false
# Retention runs every six hours while Render is awake, and once on startup.
RETENTION_WORKER_ENABLED=true

# Render Free blocks SMTP. Relay only through the selected Vercel app over HTTPS.
EMAIL_TRANSPORT=
EMAIL_RELAY_URL=
# Server-only signing key shared between Render and the Vercel production mail function.
EMAIL_RELAY_SECRET=

# Operator-reviewed public publisher hosts; additive to APPROVED_MENU_HOSTS.
PUBLISHER_MENU_HOSTS=

# Official Swiggy connection: disabled until development access is configured.
# Production additionally requires real Swiggy approval for the exact callback URI.
SWIGGY_MCP_ENABLED=false
SWIGGY_MCP_PRODUCTION_APPROVED=false
# Confirm price units with Swiggy before setting rupees or paise. Unknown never matches budgets.
SWIGGY_MCP_PRICE_UNIT=unknown
# Enable only under the Zomato agreement for this third-party app and approved redirect.
ZOMATO_MCP_ENABLED=false
ZOMATO_MCP_PRODUCTION_APPROVED=false
